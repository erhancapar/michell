{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "michell problem file, draft 0",
  "description": "Draft. The format becomes real in milestone 3 of docs/roadmap.md and may change until then. See docs/design/problem-file.md.",
  "type": "object",
  "required": ["schema", "regions", "grid", "material", "supports", "load_cases", "goal"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "michell/0" },
    "geometry": {
      "type": "object",
      "description": "One STEP file whose named bodies are the regions. Leave out when every region is its own STL file.",
      "required": ["file"],
      "additionalProperties": false,
      "properties": { "file": { "type": "string" } }
    },
    "regions": {
      "type": "object",
      "required": ["design"],
      "additionalProperties": false,
      "properties": {
        "design": { "$ref": "#/$defs/body", "description": "The space the part may fill." },
        "solid": { "type": "array", "items": { "$ref": "#/$defs/body" }, "description": "Must stay material." },
        "void": { "type": "array", "items": { "$ref": "#/$defs/body" }, "description": "Must stay empty." }
      }
    },
    "grid": {
      "type": "object",
      "required": ["voxel_mm"],
      "additionalProperties": false,
      "properties": { "voxel_mm": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "material": {
      "type": "object",
      "required": ["youngs_modulus_mpa", "poisson_ratio", "density_g_cm3"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "youngs_modulus_mpa": { "type": "number", "exclusiveMinimum": 0 },
        "poisson_ratio": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5 },
        "density_g_cm3": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["on", "fix"],
        "additionalProperties": false,
        "properties": {
          "on": { "$ref": "#/$defs/body" },
          "fix": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["x", "y", "z"] },
            "description": "The directions held. A support may hold one direction only."
          }
        }
      }
    },
    "load_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "loads"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
          "loads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["on", "force_n"],
              "additionalProperties": false,
              "properties": {
                "on": { "$ref": "#/$defs/body" },
                "force_n": { "$ref": "#/$defs/vector", "description": "Total force on the region, in newtons." }
              }
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["module", "sense"],
      "properties": {
        "module": { "type": "string" },
        "sense": { "enum": ["min", "max"] }
      },
      "description": "Further keys are the module's own settings."
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module"],
        "anyOf": [{ "required": ["max"] }, { "required": ["min"] }],
        "properties": {
          "module": { "type": "string" },
          "max": { "type": "number" },
          "min": { "type": "number" }
        },
        "description": "The bound is in the module's own unit. Further keys are the module's own settings."
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module"],
        "properties": { "module": { "type": "string" } },
        "description": "Shape rules, applied in the order listed. Further keys are the module's own settings."
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_passes": { "type": "integer", "minimum": 1 },
        "threads": { "type": "integer", "minimum": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folder": { "type": "string" },
        "mesh": { "type": "array", "uniqueItems": true, "items": { "enum": ["stl", "3mf"] } }
      }
    }
  },
  "$defs": {
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "The name of a body in the STEP file, or the path of an STL file."
    },
    "vector": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
